{
  "name": "moonbite",
  "version": "1.0.0",
  "private": true,
  "description": "Moonbite \u2014 a competitive orbital arena .io game for mobile and web.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start:server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "balance": "tsx scripts/balance.ts",
    "icons": "node scripts/icons.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "ws": "^8.22.1"
  }
}
